// The receiver distinguishes the finite and recursive branches by their labels.
global protocol MultipartyChoice(role C, role S, role D) {
  m2() from C to S;
  choice at C {
    m() from C to D;
    m1() from C to S;
  } or {
    rec SEND {
      m1() from C to D;
      m2() from C to S;
      continue SEND;
    }
  }
}
