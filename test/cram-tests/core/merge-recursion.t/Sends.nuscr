// Matching receives must not hide incompatible later sends.
global protocol Sends(role A, role B, role C) {
  choice at C {
    One() from C to A;
    rec X {
      Tick() from A to B;
      Left() from B to A;
      continue X;
    }
  } or {
    Two() from C to A;
    rec Y {
      Tick() from A to B;
      Right() from B to A;
      continue Y;
    }
  }
}
